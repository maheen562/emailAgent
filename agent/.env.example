# Copy to agent/.env and fill in. Never commit the real .env.

# --- Email source: demo | gmail | imap ---
EMAIL_PROVIDER=demo
GMAIL_QUERY=label:"Job Alerts" newer_than:3d
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
# IMAP backup only:
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- LLM: gemini | ollama ---
LLM_PROVIDER=gemini
# Free key from https://aistudio.google.com (no credit card)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Local option:
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
