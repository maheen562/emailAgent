# Copy to server/.env only if you need to change the defaults.
PORT=3000
AGENT_URL=http://localhost:8000
AGENT_TIMEOUT_MS=120000

# SQLite database file (created automatically). Defaults to server/data/jobs.db
# DB_FILE=

# Each run looks back this many days and skips emails it has already judged.
LOOKBACK_DAYS=7
FETCH_LIMIT=25
# Pause between LLM calls, to stay under the Gemini free tier's per-minute limit.
SUMMARIZE_DELAY_MS=2000
# A failing email is retried on later runs, at most this many times in total.
MAX_EMAIL_ATTEMPTS=3
